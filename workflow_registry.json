      "needs_input_video": false,
      "needs_input_audio": true,
      "needs_prompt": true,
      "needs_resolution": false,
      "needs_duration": false,
      "prompt_hint": "🎵 **Image+Audio→Video Workflow**\n\n💡 **Note:** Video length is auto-matched to audio length (max 15s)\n\nDescribe what should happen in the video:",
      "workflows": [
        "LTX2.3 - IA2V",
        "LTX2.3 - FFLFA2V",
        "LTX2.3 (4.2) - IA2V",
        "LTX2.3 (4.2) - FFMFLFA2V"
      ]
    },
